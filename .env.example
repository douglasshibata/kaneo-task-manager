# Configurações do Ambiente local de Desenvolvimento do Kaneo Task Manager

# ----------------------------------------------------
# DATABASE (PostgreSQL)
# ----------------------------------------------------
DATABASE_URL="postgresql://kaneo_user:kaneo_password@localhost:5432/kaneo_db?schema=public"

# ----------------------------------------------------
# CACHING & REALTIME (Redis)
# ----------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ----------------------------------------------------
# AUTENTICAÇÃO E SEGURANÇA (JWT)
# ----------------------------------------------------
JWT_SECRET="kaneo_super_secret_jwt_token_2026_key"

# ----------------------------------------------------
# STORAGE (MinIO / S3)
# ----------------------------------------------------
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="kaneo_admin"
MINIO_SECRET_KEY="kaneo_s3_password"
MINIO_BUCKET="kaneo-attachments"

# ----------------------------------------------------
# CONFIGURAÇÃO DE PORTAS DE EXECUÇÃO
# ----------------------------------------------------
PORT=4000
REACT_APP_API_URL="http://localhost:4000"
REACT_APP_WS_URL="ws://localhost:4000"
